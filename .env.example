# ─────────────────────────────────────────────────────────────
# Supabase — public, safe to expose to the browser
# (get these from your Supabase project dashboard → Settings → API)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Supabase — SECRET. Server-side only (route handlers, cron jobs,
# admin operations that must bypass RLS). NEVER expose to the browser.
# Required: signup auto-confirmation and the 24-hour purge job.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# CRON_SECRET — SECRET. Shared with the Vercel cron job that purges
# expired rooms hourly. The purge route requires it as a bearer token.
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Public origin of the app.
# Used for canonical URLs, redirects and cookies.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────
# Playwright E2E (OPTIONAL — live verification only)
# Required ONLY to run the live suite in e2e/*.spec.ts against a hosted
# Supabase test project. Leave unset and the suite skips cleanly. NEVER
# commit real values. Usernames are used as a base; the tests append a
# random suffix so every run gets fresh accounts.
# ─────────────────────────────────────────────────────────────
E2E_BASE_URL=
E2E_USER_A_USERNAME=
E2E_USER_A_PASSWORD=
E2E_USER_A_DISPLAY_NAME=
E2E_USER_B_USERNAME=
E2E_USER_B_PASSWORD=
E2E_USER_B_DISPLAY_NAME=

# Test harness only — required only for e2e/expiration.spec.ts, which
# force-expires a room via the TEST-ONLY service-role RPC in
# supabase/migrations/999_test_helpers.sql. The app itself must run against
# the matching NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
E2E_SUPABASE_URL=
E2E_SUPABASE_SERVICE_ROLE_KEY=
